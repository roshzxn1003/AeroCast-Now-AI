# ==============================================================================
# AeroCast-Now AI — Staging Environment (.env.staging)
# ==============================================================================
AEROCAST_ENV=staging
DATA_MODE=hybrid
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8080
VITE_API_URL=http://localhost:8080

# Isolated SQLite Staging Database
AEROCAST_DB_PATH=data/staging/aerocast_staging.sqlite3
AEROCAST_DATA_DIR=data/staging

# Ingestion Endpoints
IMD_API_URL=https://api.imd.gov.in/public/index.php
IMD_API_KEY=
IMD_RADAR_URL=https://mausam.imd.gov.in/Radar
INSAT_SATELLITE_URL=https://mausam.imd.gov.in/Satellite
RAINVIEWER_API_URL=https://api.rainviewer.com/public/weather-maps.json
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
BLITZORTUNG_ENABLED=true

# Staging Tokens & Secrets
AEROCAST_ADMIN_TOKEN=staging_admin_sec_tok_991823746152
AEROCAST_SECRET_KEY=staging_super_secret_key_88471920394857

CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://staging.aerocast.local
RATE_LIMIT_ENABLED=true
MAX_CONCURRENT_INFERENCES=2
