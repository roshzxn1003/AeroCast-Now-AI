# ==============================================================================
# AeroCast-Now AI — Testing Environment (.env.testing)
# ==============================================================================
AEROCAST_ENV=testing
DATA_MODE=hybrid
LOG_LEVEL=WARNING

HOST=127.0.0.1
PORT=8000
VITE_API_URL=http://127.0.0.1:8000

# Isolated SQLite Test Database
AEROCAST_DB_PATH=data/testing/aerocast_testing.sqlite3
AEROCAST_DATA_DIR=data/testing

# Ingestion Settings for Tests
BLITZORTUNG_ENABLED=false
IMD_API_KEY=

AEROCAST_ADMIN_TOKEN=test_fixture_admin_token_abcdef123456
AEROCAST_SECRET_KEY=testing_secret_key_mock_987654321000

CORS_ORIGINS=http://127.0.0.1:8000
RATE_LIMIT_ENABLED=false
MAX_CONCURRENT_INFERENCES=4
