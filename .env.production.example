# ==============================================================================
# AeroCast-Now AI — Production Environment Template (.env.production.example)
# Copy this file to .env.production on the secure production host.
# NEVER commit .env.production or production credentials to git!
# ==============================================================================
AEROCAST_ENV=production
DATA_MODE=real
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
VITE_API_URL=https://app.aerocast.in

# Production SQLite Database (WAL Mode on Persistent SSD Volume)
AEROCAST_DB_PATH=/app/data/aerocast.sqlite3
AEROCAST_DATA_DIR=/app/data
AEROCAST_MODEL_PATH=/app/models/convlstm_real_best.keras

# Ingestion Feeds
IMD_API_URL=https://api.imd.gov.in/public/index.php
IMD_API_KEY=YOUR_IMD_OFFICIAL_PRODUCTION_API_KEY
IMD_RADAR_URL=https://mausam.imd.gov.in/Radar
INSAT_SATELLITE_URL=https://mausam.imd.gov.in/Satellite
RAINVIEWER_API_URL=https://api.rainviewer.com/public/weather-maps.json
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
BLITZORTUNG_ENABLED=true

# Mandatory Cryptographic Secrets (Must be at least 16 and 24 chars respectively)
AEROCAST_ADMIN_TOKEN=REPLACE_WITH_HIGH_ENTROPY_RANDOM_ADMIN_TOKEN_64_CHARS
AEROCAST_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_RANDOM_SECRET_KEY_64_CHARS

CORS_ORIGINS=https://aerocast.in,https://app.aerocast.in
RATE_LIMIT_ENABLED=true
MAX_CONCURRENT_INFERENCES=2
