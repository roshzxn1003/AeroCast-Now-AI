# ==============================================================================
# AeroCast-Now AI — Development Environment (.env.development)
# ==============================================================================
AEROCAST_ENV=development
DATA_MODE=hybrid
LOG_LEVEL=DEBUG

HOST=0.0.0.0
PORT=8000
VITE_API_URL=http://localhost:8000

# SQLite Development Database
AEROCAST_DB_PATH=data/aerocast.sqlite3
AEROCAST_DATA_DIR=data

# Ingestion Endpoints & Keys
IMD_API_URL=https://api.imd.gov.in/public/index.php
IMD_API_KEY=
IMD_RADAR_URL=https://mausam.imd.gov.in/Radar
INSAT_SATELLITE_URL=https://mausam.imd.gov.in/Satellite
RAINVIEWER_API_URL=https://api.rainviewer.com/public/weather-maps.json
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
BLITZORTUNG_ENABLED=true

# Development Secret & Token
AEROCAST_ADMIN_TOKEN=dev_admin_token_for_local_testing_only
AEROCAST_SECRET_KEY=dev_secret_key_change_in_production_1234567890

CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173
RATE_LIMIT_ENABLED=false
MAX_CONCURRENT_INFERENCES=2
