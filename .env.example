# ==============================================================================
# AeroCast-Now AI — Environment Configuration
# ==============================================================================

# Operational Data Mode
# Options:
#   - hybrid     (Recommended): Fuses live IMD/RainViewer radar, INSAT-3D satellite,
#                Blitzortung lightning, and Open-Meteo convective profiles with AI models.
#   - real       : Strict live observation ingestion only. Missing sensors will report
#                degraded status rather than synthesizing data.
#   - simulation : Offline simulation mode utilizing synthetic convective storm fields
#                (Severe Squall Line, Supercell Thunderstorm, Multi-Cell Cluster).
DATA_MODE=hybrid

# Ingestion Endpoints & Keys
IMD_API_URL=https://api.imd.gov.in/public/index.php
IMD_API_KEY=
IMD_RADAR_URL=https://mausam.imd.gov.in/Radar
INSAT_SATELLITE_URL=https://mausam.imd.gov.in/Satellite
RAINVIEWER_API_URL=https://api.rainviewer.com/public/weather-maps.json
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Lightning Network (Blitzortung LDN WebSocket/TCP)
BLITZORTUNG_ENABLED=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
VITE_API_URL=http://localhost:8000
